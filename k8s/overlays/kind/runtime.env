SPRING_PROFILES_ACTIVE=kind
PORT=8080
SERVER_SHUTDOWN=graceful
DB_URL=jdbc:postgresql://postgres:5432/inventory_db
DB_USERNAME=inventory_user
SPRING_FLYWAY_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_ENDPOINT_HEALTH_GROUP_LIVENESS_INCLUDE=livenessState
MANAGEMENT_ENDPOINT_HEALTH_GROUP_READINESS_INCLUDE=readinessState,db
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=never
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65 -XX:ActiveProcessorCount=2
