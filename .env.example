# Credenciais exclusivamente para o PostgreSQL descartável de I1.
PORT=18081
DB_URL=jdbc:postgresql://127.0.0.1:55481/inventory_db
DB_USERNAME=inventory_i1
DB_PASSWORD=i1-local-inventory
OS_TO_INVENTORY_TOKEN=i1-local-os-to-inventory
BILLING_TO_INVENTORY_TOKEN=i1-local-billing-to-inventory
# Apenas em loopback ou rede privada com Gateway que remove e reinjeta os cabeçalhos.
GATEWAY_HEADERS_TRUSTED=true
