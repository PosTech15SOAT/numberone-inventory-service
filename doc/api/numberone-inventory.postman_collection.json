{
  "info": {
    "name": "NumberOne Inventory · Fase 4",
    "description": "Use somente em ambiente local ou de homologação controlado. Ajuste baseUrl, IDs dos cadastros existentes e as credenciais no ambiente privado do Postman. Headers X-Authenticated-* reproduzem apenas o contexto local; na entrada externa use o contrato publicado pela plataforma. Use um UUID novo para cada nova operação e preserve a chave na repetição da mesma operação.\n\nOS e Billing usam credenciais diferentes nas rotas internas. Na reversão, forneça evidência operacional e use o mesmo ID ao repetir o pedido.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "billingToInventory",
      "value": ""
    },
    {
      "key": "compensationId",
      "value": "00000000-0000-4000-8000-000000000004"
    },
    {
      "key": "correlationId",
      "value": "00000000-0000-4000-8000-000000000001"
    },
    {
      "key": "inventoryItemId",
      "value": ""
    },
    {
      "key": "operationId",
      "value": "00000000-0000-4000-8000-000000000003"
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "orderItemId",
      "value": ""
    },
    {
      "key": "osToInventory",
      "value": ""
    },
    {
      "key": "subject",
      "value": "00000000-0000-4000-8000-000000000002"
    }
  ],
  "item": [
    {
      "name": "Saúde da aplicação",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/actuator/health"
      }
    },
    {
      "name": "Catálogo e movimentações",
      "item": [
        {
          "name": "Cadastrar material",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Subject",
                "value": "{{subject}}",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Status",
                "value": "ACTIVE",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Roles",
                "value": "ADMIN",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Permissions",
                "value": "",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/admin/itens",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"HML-PECA-001\",\n  \"nome\": \"Peça de teste\",\n  \"tipoItem\": \"PECA\",\n  \"unidadeMedida\": \"UNIDADE\",\n  \"custoUnitario\": 10,\n  \"precoVenda\": 20.4,\n  \"quantidadeEstoque\": 0,\n  \"estoqueMinimo\": 1,\n  \"ativo\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar materiais",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Subject",
                "value": "{{subject}}",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Status",
                "value": "ACTIVE",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Roles",
                "value": "ADMIN",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Permissions",
                "value": "",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/admin/itens"
          }
        },
        {
          "name": "Consultar material",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Subject",
                "value": "{{subject}}",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Status",
                "value": "ACTIVE",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Roles",
                "value": "ADMIN",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Permissions",
                "value": "",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/admin/itens/{{inventoryItemId}}"
          }
        },
        {
          "name": "Registrar entrada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Subject",
                "value": "{{subject}}",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Status",
                "value": "ACTIVE",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Roles",
                "value": "ADMIN",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Permissions",
                "value": "",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/admin/estoque/entrada",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idItemEstoque\": \"{{inventoryItemId}}\",\n  \"quantidade\": 3,\n  \"origemMovimentacao\": \"MANUAL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Consultar movimentações",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Subject",
                "value": "{{subject}}",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Status",
                "value": "ACTIVE",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Roles",
                "value": "ADMIN",
                "type": "text"
              },
              {
                "key": "X-Authenticated-Permissions",
                "value": "",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/admin/estoque/itens/{{inventoryItemId}}/movimentacoes"
          }
        }
      ]
    },
    {
      "name": "Contratos internos",
      "item": [
        {
          "name": "CT-04 · Consultar preços",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{billingToInventory}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/internal/inventory/consultar-precos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inventoryItemIds\": [\n    \"{{inventoryItemId}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Consultar referência de material",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{osToInventory}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/internal/inventory/items/{{inventoryItemId}}"
          }
        },
        {
          "name": "CT-05 · Consumir lote",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{osToInventory}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{operationId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/internal/inventory/consumptions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operationId\": \"{{operationId}}\",\n  \"serviceOrderId\": \"{{orderId}}\",\n  \"serviceOrderItemId\": \"{{orderItemId}}\",\n  \"responsibleUserId\": \"{{subject}}\",\n  \"items\": [\n    {\n      \"inventoryItemId\": \"{{inventoryItemId}}\",\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "CT-08 · Consultar operação",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{osToInventory}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/internal/inventory/operations/{{operationId}}"
          }
        },
        {
          "name": "CT-08B · Compensar operação",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{osToInventory}}",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{compensationId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/internal/inventory/consumptions/{{operationId}}/reversal",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"compensationId\": \"{{compensationId}}\",\n  \"reason\": \"VERIFIED_RETURN\",\n  \"unusedConfirmed\": true,\n  \"evidence\": {\n    \"verifiedBy\": \"{{subject}}\",\n    \"verifiedAt\": \"{{$isoTimestamp}}\",\n    \"reference\": \"Devolução de teste conferida\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
